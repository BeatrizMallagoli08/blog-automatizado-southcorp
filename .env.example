# Copie para .env e preencha para testar localmente (nunca commitar o .env real).
# Em produção, essas chaves ficam em Settings -> Secrets and variables -> Actions no GitHub.

ANTHROPIC_API_KEY=
WP_SITE_URL=https://seusite.com.br
WP_USERNAME=
WP_APPLICATION_PASSWORD=
DISCORD_WEBHOOK_URL=
UNSPLASH_ACCESS_KEY=

# Opcionais (cópia em Google Doc)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Opcional — quantos posts gerar por execução (padrão 5)
POSTS_PER_RUN=5

# --- Revista Sinduscon (revista/) ---
# ANTHROPIC_API_KEY acima é reaproveitada.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
DISCORD_WEBHOOK_URL_REVISTA=
# Opcional — só se quiser também uma cópia em Google Doc (reaproveita as duas
# variáveis de Google acima, com uma pasta diferente):
GOOGLE_DRIVE_FOLDER_ID_REVISTA=
